# Copy this file to .env and fill in real values. .env is git-ignored.

# Supabase project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key. Safe for the browser; access is enforced by RLS.
VITE_SUPABASE_ANON_KEY=

# Backend only (set these in the Railway environment, not in this file):
#   SUPABASE_URL
#   SUPABASE_SERVICE_KEY   <- service-role key, bypasses RLS. Never expose to the frontend.
